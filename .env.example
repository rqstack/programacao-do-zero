# Copie para .env.local (desenvolvimento) ou .env.production (publicação).
# Os dois valores do Supabase são públicos por natureza (vão no site estático);
# a segurança dos dados vem das regras RLS do banco. Veja docs/CONFIGURACAO.md.
NEXT_PUBLIC_SUPABASE_URL=https://seu-projeto.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sua-chave-anon-publica

# Subcaminho do GitHub Pages (o npm run deploy preenche sozinho).
NEXT_PUBLIC_BASE_PATH=

# NUNCA coloque a chave service_role em arquivos do site.
